# N8N Configuration
VITE_N8N_WEBHOOK_ID=your-webhook-id-here
VITE_N8N_BASE_URL=http://localhost:5678

# CORS Configuration
# Specify allowed origins for CORS (comma-separated for multiple origins)
# Examples:
# VITE_CORS_WHITELIST=https://yourdomain.com
# VITE_CORS_WHITELIST=https://yourdomain.com,https://anotherdomain.com
# VITE_CORS_WHITELIST=* (allows all origins - not recommended for production)
VITE_CORS_WHITELIST=* 